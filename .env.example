# Copy this file to .env and fill values for your local environment.

USE_MEDGEMMA=true
REQUIRE_MEDGEMMA=false
MEDGEMMA_BASE_URL=
MEDGEMMA_API_KEY=
MEDGEMMA_MODEL=medgemma
MEDGEMMA_API_STYLE=openai_chat
MEDGEMMA_GENERATE_PATH=/generate

USE_VALIDATION_KG=true
VALIDATION_KG_BACKEND=neo4j
VALIDATION_KG_PATH=./data/coding_knowledge_graph.json
# The DGX API container uses network_mode: host. Point this at the host port
# published by the selected Neo4j container (7688 in the containerized stack).
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
NEO4J_VERIFY_CONNECTIVITY=true
NEO4J_QUERY_TIMEOUT_SECONDS=10
NEO4J_CONNECTION_TIMEOUT_SECONDS=10
NEO4J_MAX_CONNECTION_LIFETIME_SECONDS=300
USE_VALIDATION_LLM=false
VALIDATION_LLM_BASE_URL=
VALIDATION_LLM_API_KEY=
VALIDATION_LLM_MODEL=medgemma
VALIDATION_LLM_API_STYLE=openai_chat
VALIDATION_LLM_GENERATE_PATH=/generate

# Correction suggestions use the same DGX MedGemma service by default.
# Override these only when correction inference has a dedicated deployment.
USE_CORRECTION_LLM=true
# Root docker-compose.yml reaches the DGX model_server through this host alias.
CORRECTION_LLM_BASE_URL=http://host.docker.internal:8080/v1
CORRECTION_LLM_API_KEY=
CORRECTION_LLM_MODEL=medgemma-4b-it
CORRECTION_LLM_API_STYLE=openai_chat
CORRECTION_LLM_GENERATE_PATH=/generate
CORRECTION_LLM_TIMEOUT_SECONDS=30
CORRECTION_LLM_MIN_CONFIDENCE=0.80

# Payer rules: live internal service -> PostgreSQL/cache -> versioned file.
PAYER_RULES_PATH=./data/payer_rules/default_rules.json
PAYER_REGISTRY_PATH=./data/payers/phase1_payers.json
PAYER_RULES_URL=
PAYER_RULES_ACCESS_TOKEN=
PAYER_RULES_TIMEOUT_SECONDS=20

# FHIR_ADAPTER chooses the EHR/HIE profile behind the common FHIR reader.
# Supported: generic, epic, trakcare_iris, oracle_health, nabidh
FHIR_ADAPTER=generic
FHIR_BASE_URL=
FHIR_ACCESS_TOKEN=
FHIR_AUTH_TYPE=STATIC_BEARER
FHIR_TOKEN_URL=
FHIR_CLIENT_ID=
FHIR_CLIENT_SECRET=
FHIR_CLIENT_AUTH_METHOD=client_secret_basic
FHIR_SCOPE=system/Patient.read system/Patient.search system/Coverage.read system/Coverage.search system/Encounter.read system/Encounter.search system/Practitioner.read system/Practitioner.search system/Organization.read system/Organization.search system/Condition.read system/Condition.search system/Procedure.read system/Procedure.search system/DocumentReference.read system/DocumentReference.search system/ChargeItem.read system/ChargeItem.search
FHIR_AUDIENCE=
FHIR_PRIVATE_KEY_PATH=./keys/nonprod/private.pem
FHIR_KEY_ID=
FHIR_JWKS_URL=
FHIR_TIMEOUT_SECONDS=30

# Epic profile. If empty, the adapter falls back to the generic FHIR_* values.
EPIC_FHIR_BASE_URL=
EPIC_FHIR_AUTH_TYPE=
EPIC_FHIR_TOKEN_URL=
EPIC_FHIR_CLIENT_ID=
EPIC_FHIR_CLIENT_SECRET=
EPIC_FHIR_CLIENT_AUTH_METHOD=
EPIC_FHIR_SCOPE=
EPIC_FHIR_AUDIENCE=
EPIC_FHIR_PRIVATE_KEY_PATH=
EPIC_FHIR_KEY_ID=
EPIC_FHIR_JWKS_URL=

# InterSystems TrakCare / IRIS for Health profile.
TRAKCARE_FHIR_BASE_URL=
TRAKCARE_FHIR_AUTH_TYPE=
TRAKCARE_FHIR_TOKEN_URL=
TRAKCARE_FHIR_CLIENT_ID=
TRAKCARE_FHIR_CLIENT_SECRET=
TRAKCARE_FHIR_CLIENT_AUTH_METHOD=
TRAKCARE_FHIR_SCOPE=
TRAKCARE_FHIR_AUDIENCE=
TRAKCARE_FHIR_PRIVATE_KEY_PATH=
TRAKCARE_FHIR_KEY_ID=
TRAKCARE_FHIR_JWKS_URL=

# Oracle Health / Cerner Millennium profile.
ORACLE_HEALTH_FHIR_BASE_URL=
ORACLE_HEALTH_FHIR_AUTH_TYPE=
ORACLE_HEALTH_FHIR_TOKEN_URL=
ORACLE_HEALTH_FHIR_CLIENT_ID=
ORACLE_HEALTH_FHIR_CLIENT_SECRET=
ORACLE_HEALTH_FHIR_CLIENT_AUTH_METHOD=
ORACLE_HEALTH_FHIR_SCOPE=
ORACLE_HEALTH_FHIR_AUDIENCE=
ORACLE_HEALTH_FHIR_PRIVATE_KEY_PATH=
ORACLE_HEALTH_FHIR_KEY_ID=
ORACLE_HEALTH_FHIR_JWKS_URL=

# NABIDH Dubai HIE profile.
NABIDH_FHIR_BASE_URL=
NABIDH_FHIR_AUTH_TYPE=
NABIDH_FHIR_TOKEN_URL=
NABIDH_FHIR_CLIENT_ID=
NABIDH_FHIR_CLIENT_SECRET=
NABIDH_FHIR_CLIENT_AUTH_METHOD=
NABIDH_FHIR_SCOPE=
NABIDH_FHIR_AUDIENCE=
NABIDH_FHIR_PRIVATE_KEY_PATH=
NABIDH_FHIR_KEY_ID=
NABIDH_FHIR_JWKS_URL=

NPHIES_SOURCE_ENDPOINT=https://velodoc.ai/fhir
NPHIES_PROCESS_MESSAGE_URL=
NPHIES_ELIGIBILITY_URL=
NPHIES_ELIGIBILITY_POLL_URL=
NPHIES_PRIOR_AUTH_URL=
NPHIES_PRIOR_AUTH_POLL_URL=
NPHIES_CLAIM_SUBMISSION_URL=
NPHIES_CLAIM_POLL_URL=
NPHIES_ACCESS_TOKEN=
SHAFAFIYA_PRIOR_AUTH_URL=
ECLAIMLINK_PRIOR_AUTH_URL=
ECLAIMLINK_ELIGIBILITY_URL=
ECLAIMLINK_ELIGIBILITY_POLL_URL=
ECLAIMLINK_PRIOR_AUTH_POLL_URL=
ECLAIMLINK_CLAIM_SUBMISSION_URL=
ECLAIMLINK_CLAIM_POLL_URL=
ECLAIMLINK_ACCESS_TOKEN=
PAYER_TRANSPORT_TIMEOUT_SECONDS=30
PRIOR_AUTH_ENDPOINT_URL=
PRIOR_AUTH_POLL_URL=
PRIOR_AUTH_ACCESS_TOKEN=
PRIOR_AUTH_DRY_RUN=true
PRIOR_AUTH_AUTO_SUBMIT=false
PRIOR_AUTH_POLL_ENABLED=false
PRIOR_AUTH_DRY_RUN_STATUS=queued
PRIOR_AUTH_DRY_RUN_FINAL_STATUS=
PRIOR_AUTH_DRY_RUN_FINAL_DECISION=
ELIGIBILITY_AUTO_SUBMIT=false

# Payload/profile validation. Shafafiya XSD validation requires lxml and
# data/schemas/shafafiya/v2.0/CommonTypes.xsd beside these transaction schemas.
NPHIES_PROFILE_REQUIRED=true
NPHIES_FHIR_VALIDATOR_COMMAND=
NPHIES_FHIR_VALIDATOR_TIMEOUT_SECONDS=60
SHAFAFIYA_CLAIM_XSD_PATH=./data/schemas/shafafiya/v2.0/ClaimSubmission.xsd
SHAFAFIYA_PRIOR_REQUEST_XSD_PATH=./data/schemas/shafafiya/v2.0/PriorRequest.xsd
SHAFAFIYA_PRIOR_AUTHORIZATION_XSD_PATH=./data/schemas/shafafiya/v2.0/PriorAuthorization.xsd
SHAFAFIYA_DISPOSITION_FLAG=PTE_VALIDATE_ONLY
SHAFAFIYA_RESPONSE_DISPOSITION_FLAG=PTE_RESPONSE
ECLAIMLINK_CLAIM_XSD_PATH=

DEFAULT_TRIGGER_SOURCE=VELO_DOCTOR_APPROVED_ENCOUNTER
DEFAULT_CLAIM_FORMAT=AUTO
DEFAULT_JURISDICTION=AUTO

# FastAPI + frontend
VELO_CLAIM_API_HOST=0.0.0.0
VELO_CLAIM_API_PORT=8002
VITE_API_BASE_URL=http://127.0.0.1:8002

# Manual PDF encounter ingestion. OCR is used only for scanned PDFs.
PDF_ENCOUNTER_MAX_BYTES=10485760
PDF_ENCOUNTER_MAX_PAGES=100
PDF_ENCOUNTER_USE_LLM=false
ENCOUNTER_EXTRACTION_LLM_BASE_URL=
ENCOUNTER_EXTRACTION_LLM_API_KEY=
ENCOUNTER_EXTRACTION_LLM_MODEL=medgemma
PDF_OCR_ENDPOINT=
PDF_OCR_ACCESS_TOKEN=
PDF_OCR_TIMEOUT_SECONDS=90

# Controlled Shafafiya delivery. Keep disabled until manual/PTE onboarding is complete.
VELO_SUBMISSION_MODE=disabled
SHAFAFIYA_SENDER_ID=
SHAFAFIYA_LOGIN=
SHAFAFIYA_PASSWORD=
SHAFAFIYA_TIMEOUT_SECONDS=30
SHAFAFIYA_ENABLE_PRODUCTION=false
# JSON mapping of private bearer token (minimum 32 characters) to reviewer name.
VELO_SUBMISSION_REVIEWERS={}

VELO_CLAIM_STORAGE=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/velo_claim?sslmode=require

#for AWS when in production, use the following instead:
OBJECT_STORE_BUCKET=velo-claim-prod
OBJECT_STORE_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_DEFAULT_REGION=me-central-1

#for the test mode we use Minio
OBJECT_STORE_BUCKET=velo-claim-prod
OBJECT_STORE_ENDPOINT_URL=https://minio.your-domain.com
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...

#redis
REDIS_URL=rediss://:PASSWORD@HOST:6379/0
