# Add these values to your existing environment; never commit actual credentials.
VELO_SUBMISSION_MODE=disabled
SHAFAFIYA_SENDER_ID=
SHAFAFIYA_LOGIN=
SHAFAFIYA_PASSWORD=
SHAFAFIYA_TIMEOUT_SECONDS=30
SHAFAFIYA_ENABLE_PRODUCTION=false
# JSON object: private token (at least 32 chars) -> named reviewer identity.
VELO_SUBMISSION_REVIEWERS={}
# Existing storage configuration is separate from the payer environment:
# VELO_CLAIM_STORAGE=memory for local synthetic exercises, production for persistent tracking.
